{
  "name": "@benchside/scaffold-theme-default",
  "version": "0.0.1",
  "description": "Default semantic theme (light + dark) for @benchside/scaffold.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./light.css": "./dist/light.css",
    "./dark.css": "./dist/dark.css",
    "./spacing.css": "./dist/spacing.css",
    "./typography.css": "./dist/typography.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "prepublishOnly": "node ../../scripts/copy-license.mjs"
  },
  "keywords": [
    "design-system",
    "theme",
    "css-variables",
    "dark-mode",
    "design-tokens"
  ],
  "author": "Benchside",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benchside/scaffold.git",
    "directory": "packages/theme-default"
  },
  "homepage": "https://github.com/benchside/scaffold/tree/main/packages/theme-default",
  "bugs": "https://github.com/benchside/scaffold/issues",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0"
  }
}
